rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in Google/Firebase user can access only their own app data.
    match /users/{userId}/appData/{documentId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId
                         && documentId == "main"
                         && request.resource.data.data is map
                         && request.resource.data.updatedAt is int
                         && request.resource.data.data.keys().hasAll(["customers", "meals", "payments"]);
    }
  }
}
